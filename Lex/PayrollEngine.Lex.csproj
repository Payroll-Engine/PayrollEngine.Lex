<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>PayrollEngine.Lex</AssemblyName>
		<RootNamespace>PayrollEngine.Lex</RootNamespace>
		<Description>Payroll Engine Lex — compliance source manifests, snapshots and checks</Description>
	</PropertyGroup>

	<!-- help file generation -->
	<PropertyGroup>
		<DocumentationFile>$(AssemblyName).xml</DocumentationFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="PayrollEngine.Lex.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ExcelDataReader" Version="3.9.0" />
		<PackageReference Include="PdfPig" Version="0.1.16" />
	</ItemGroup>

	<!-- language files: next to the library in the build output and in the output of the package consumers -->
	<ItemGroup>
		<None Include="LexVocabulary\*.json" CopyToOutputDirectory="PreserveNewest" Pack="true"
		      PackagePath="contentFiles\any\$(TargetFramework)\LexVocabulary\" PackageCopyToOutput="true" PackageFlatten="false" />
	</ItemGroup>

	<!-- lex.json schema, read by Schema.Json -->
	<ItemGroup>
		<EmbeddedResource Include="lex.schema.json" LogicalName="PayrollEngine.Lex.lex.schema.json" />
	</ItemGroup>

	<!-- include xml documention files to the nuget package -->
	<ItemGroup>
		<None Include="$(OutputDir)*.xml" Pack="true">
			<PackageCopyToOutput>true</PackageCopyToOutput>
		</None>
	</ItemGroup>
	<ItemGroup>
	  <None Include="..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\THIRD-PARTY-NOTICES.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<!--  publish json schema -->
	<Target Name="PublishJsonSchema" AfterTargets="Build" Condition="exists('$(PayrollEngineSchemaDir)')">
		<Message Importance="High" Text="Publish schema..." />
		<Copy SourceFiles="$(ProjectDir)lex.schema.json" DestinationFiles="$(PayrollEngineSchemaDir)\PayrollEngine.Lex.schema.json" SkipUnchangedFiles="true" />
	</Target>

	<!-- publish package -->
	<Target Name="PublishPackage" AfterTargets="Pack" Condition="exists('$(PayrollEnginePackageDir)')">
		<Message Importance="High" Text="Publish package..." />
		<Copy SourceFiles="$(OutputPath)..\$(PackageId).$(PackageVersion).nupkg" DestinationFolder="$(PayrollEnginePackageDir)" />
	</Target>

</Project>
